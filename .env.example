# ─── API ACCESS TOKENS ──────────────────────────────────────────────────
UPSTOX_CLIENT_ID="your_upstox_client_id"
UPSTOX_CLIENT_SECRET="your_upstox_client_secret"
UPSTOX_ACCESS_TOKEN="your_upstox_access_token"
REDIRECT_URI="https://your-domain.com/callback"
ANALYTICS_TOKEN="your_analytics_token"

# ─── AI / LLM API KEYS ──────────────────────────────────────────────────
GROQ_API_KEY="your_groq_api_key"
ANTHROPIC_API_KEY="your_anthropic_api_key"

# ─── TELEGRAM ALERTING ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_db_password"
DB_NAME="trade_history"

# ── JWT Auth Configuration ───────────────────────────────────────────────────
JWT_SECRET="generate_a_random_64_char_hex_string"
JWT_REFRESH_SECRET="generate_another_random_64_char_hex_string"
ACCESS_TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# -- AES-256 Credential Encryption Key (KEEP SECRET) -----------------------
CREDENTIAL_ENCRYPTION_KEY="generate_a_random_64_char_hex_string"

# ─── TRADING MODE ────────────────────────────────────────────────────────
PAPER_TRADING_MODE=true
